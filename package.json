{
  "name": "speakingwords",
  "version": "0.1.0",
  "description": "An output parser for agent replies. Installs a style contract as configuration, in memory mode or hook mode, in a terse or conversational voice.",
  "license": "MIT",
  "bin": {
    "speakingwords": "bin/speakingwords.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "lib/",
    "skill/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "eval:p1": "python3 evals/run_deterministic.py",
    "eval:p2": "node evals/run_p2.js",
    "eval:p3": "python3 evals/run_p3.py",
    "eval:p4": "python3 evals/run_p4.py",
    "eval:p5": "python3 evals/run_p5.py",
    "eval:p6": "python3 evals/run_p6.py",
    "eval:deterministic": "npm run eval:p1 && npm run eval:p2 && npm run eval:p3 && npm run eval:p4 && npm run eval:p5 && npm run eval:p6",
    "eval": "npm run eval:deterministic"
  },
  "keywords": [
    "claude-code",
    "codex",
    "codex-cli",
    "agent",
    "style",
    "output-style",
    "linter",
    "lexicon",
    "hooks",
    "stop-hook",
    "cli"
  ],
  "repository": "TODO-set-repository-url-before-publishing",
  "homepage": "TODO-set-homepage-url-before-publishing",
  "bugs": {
    "url": "TODO-set-issue-tracker-url-before-publishing"
  }
}
