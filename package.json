{
  "name": "speakingwords",
  "version": "0.3.1",
  "description": "An output parser for agent replies. Installs a style contract as configuration, in memory mode or hook mode, in a terse or conversational voice.",
  "license": "MIT",
  "bin": {
    "speakingwords": "bin/speakingwords.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "lib/",
    "skill/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "eval:p1": "python3 evals/run_deterministic.py",
    "eval:p2": "node evals/run_p2.js",
    "eval:p3": "python3 evals/run_p3.py",
    "eval:p4": "python3 evals/run_p4.py",
    "eval:p5": "python3 evals/run_p5.py",
    "eval:p6": "python3 evals/run_p6.py",
    "eval:p7": "node evals/run_p7.js",
    "eval:p8": "python3 evals/run_p8.py",
    "eval:p9": "python3 evals/run_p9.py",
    "eval:p10": "python3 evals/run_p10.py",
    "eval:p13": "python3 evals/run_p13.py",
    "eval:p15": "python3 evals/run_p15.py",
    "eval:p16": "python3 evals/run_p16.py",
    "eval:deterministic": "npm run eval:p1 && npm run eval:p2 && npm run eval:p3 && npm run eval:p4 && npm run eval:p5 && npm run eval:p6 && npm run eval:p7 && npm run eval:p8 && npm run eval:p9 && npm run eval:p10 && npm run eval:p13 && npm run eval:p15 && npm run eval:p16",
    "eval": "npm run eval:deterministic"
  },
  "keywords": [
    "claude-code",
    "codex",
    "codex-cli",
    "agent",
    "style",
    "output-style",
    "linter",
    "lexicon",
    "hooks",
    "stop-hook",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndisisnd/speakingwords.git"
  },
  "homepage": "https://github.com/ndisisnd/speakingwords#readme",
  "bugs": {
    "url": "https://github.com/ndisisnd/speakingwords/issues"
  },
  "dependencies": {
    "speakingwords": "^0.3.1"
  }
}
